# Environment Variables Template for FinFlow v2
# Copy this to .env file for local development
# DO NOT commit .env to git!

# Production Settings
FLASK_ENV=production
FINFLOW_ENV=production

# Secret Key (Generate a strong random key - 32+ characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-random-key-here-min-32-chars

# Database URL (Optional - defaults to SQLite)
# For PostgreSQL: postgresql://user:password@localhost:5432/finflow_v2
# For SQLite (default): sqlite:///finflow.db
DATABASE_URL=sqlite:///finflow.db

# Upload folder for avatars
UPLOAD_FOLDER=static/img/avatars

# Port (will be overridden by hosting provider)
PORT=5001
